+/// Keep partially started teams away from barriers with a fixed participant
+/// count. None means pending; Some(true) means all workers started; and
+/// Some(false) means startup was cancelled before the team became usable.
+struct BarrierPoolStartup {
+    state: Mutex<Option<bool>>,
+    changed: Condvar,
+}
+impl BarrierPoolStartup {
+    fn new() -> Self {
+        Self {
+            state: Mutex::new(None),
+            changed: Condvar::new(),
+        }
+    }
+
+    fn wait(&self) -> bool {
+        let state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+        let state = self
+            .changed
+            .wait_while(state, |state| state.is_none())
+            .unwrap_or_else(|error| error.into_inner());
+        *state == Some(true)
+    }
+
+    fn release(&self, ready: bool) {
+        let mut state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+        if state.is_none() {
+            *state = Some(ready);
+            self.changed.notify_all();
+        }
+    }
+}
+
+/// This guard must live inside thread::scope's closure so cancellation runs
+/// before scope tries to join workers during an early return or unwinding.
+struct CancelBarrierPoolStartup<'a>(&'a BarrierPoolStartup);
+impl Drop for CancelBarrierPoolStartup<'_> {
+    fn drop(&mut self) {
+        self.0.release(false);
+    }
+}
