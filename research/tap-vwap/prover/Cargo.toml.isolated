[package]
name = "tap-vwap-nova-prover"
version = "0.1.0"
edition = "2021"
publish = false
description = "Isolated TAP-VWAP-03 native witness verifier, BIP-340/SHA-256 R1CS circuit, and Nova recursive VWAP accumulator"

[dependencies]
nova-snark = { version = "=0.76.0", default-features = true }
halo2curves = { version = "=0.9.0", default-features = false, features = ["std", "bits", "derive_serde"] }
ff = { version = "=0.13.1", default-features = false, features = ["bits", "std"] }
group = { version = "=0.13.0", default-features = false, features = ["alloc"] }
generic-array = { version = "=0.14.7", default-features = false }
subtle = { version = "=2.6.1", default-features = false, features = ["std"] }
secp256k1 = { version = "=0.30.0", default-features = false, features = ["std", "global-context"] }
sha2 = { version = "=0.10.9", default-features = false, features = ["std", "compress"] }
bincode = { version = "=1.3.3", default-features = false }
serde = { version = "=1.0.228", default-features = false, features = ["std", "derive"] }
serde_json = { version = "=1.0.149", default-features = false, features = ["std"] }
hex = { version = "=0.4.3", default-features = false, features = ["std"] }

[profile.release]
opt-level = 3
debug = false

[profile.test]
opt-level = 3

[lib]
name = "tap_vwap_nova_prover"
path = "src/lib.rs"

[[bin]]
name = "tap-vwap-prover"
path = "src/main.rs"

[workspace]
